# PlanzyPop AI - Backend Environment Configuration Example
# Copy this file to `backend/.env` and supply your actual credentials.
# NEVER commit your real `.env` file to version control.

# Database Connection URL
# For Neon PostgreSQL (Serverless Cloud Database):
# 1. In your Neon Console (console.neon.tech), navigate to your project dashboard.
# 2. Under "Connection Details", copy the connection string.
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# If left blank, the application automatically uses embedded SQLite (backend/planzypop.db).
DATABASE_URL=
# Geoapify Places API Key (used for structured Chandigarh place discovery)
# Free Plan features:
# - 3,000 requests / credits per day
# - 5 requests per second rate limit
# - No payment card required to register
# - Free signup at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Environment mode: development / production
ENVIRONMENT=development
